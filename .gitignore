# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# IDE / notebooks
.vscode/
.idea/
.ipynb_checkpoints/

# Environment
venv/
.env

# Model weights — downloaded separately, see README
/models/*
!/models/.gitkeep
!/models/GroundingDINO_SwinT_OGC.py
/resources/weights/

# Runtime outputs
/results/*
!/results/.gitkeep
/databases/
catboost_info/
nohup*.out
*.lmdb/
*.h5
*.parquet
*.pkl

# data/ is your workspace and is not tracked — except the bundled lizard demo
# set (the `lizard_*` names). Anything you add under your own names stays out.
/data/*
!/data/README.md
!/data/lizard_demo_ground_truth.json

!/data/lizard_demo_ground_truth.json
!/data/zebra_demo_ground_truth.json

!/data/images-pattern/
/data/images-pattern/*
!/data/images-pattern/lizard_*/

# Raw photographs for the new-species demo (demo-3). Only the zebra_* names.
!/data/images/
/data/images/*
!/data/images/zebra_*/

# Raw photographs for demo-0, which shows the preparation stages. Kept out of
# data/images/ on purpose: demo-3 treats every directory in there as a gallery
# individual, and these are neither zebras nor a gallery.
!/data/raw-demo/

# Segmentation output is regenerated by demo-3, never committed.
/data/images-segmented/

!/data/new/
/data/new/*
!/data/new/lizard_demo-pattern/
!/data/new/zebra_demo/
/data/new/zebra_demo-segmented/
